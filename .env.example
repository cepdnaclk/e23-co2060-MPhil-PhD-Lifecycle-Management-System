# Application
APP_BASE_URL=http://127.0.0.1:3000
NEXT_TELEMETRY_DISABLED=1

# PostgreSQL / Prisma
DATABASE_URL=postgresql://pglms:replace-me@127.0.0.1:5432/pglms_dev?schema=public
TEST_DATABASE_URL=postgresql://pglms:replace-me@127.0.0.1:5432/pglms_test?schema=public
ALLOW_REMOTE_TEST_DATABASE=false
ALLOW_SAMPLE_DATA_RESET=false
RESET_SAMPLE_STORAGE=false
PGLMS_SEED_SAMPLE_DATA=false

# Firebase client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-me
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-me
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=replace-me

# Firebase Admin SDK
FIREBASE_PROJECT_ID=replace-me
FIREBASE_CLIENT_EMAIL=replace-me
FIREBASE_PRIVATE_KEY=replace-me
SESSION_COOKIE_NAME=pglms_session
SESSION_ACTIVITY_COOKIE_NAME=pglms_session_activity

# Supabase Storage
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=replace-me
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=replace-me

# Staged-document verification and public application abuse controls
# Production must use an HTTP scanner that accepts raw bytes and returns {"clean": true}.
MALWARE_SCANNER_URL=https://replace-me.example.invalid/scan
MALWARE_SCANNER_TOKEN=replace-me
PUBLIC_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
# Local/test-only escape hatch; do not set this to structural in production.
FILE_SCAN_MODE=structural

# SMTP
SMTP_HOST=replace-me
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=PGLMS <replace-me@example.invalid>

# Scheduled maintenance
CRON_SECRET=replace-me
PROGRESS_REPORT_OVERDUE_AFTER_DAYS=30

# Optional idempotent development seed users.
# Supply only accounts that already exist in Firebase; never put passwords here.
# Example: [{"role":"HOD","email":"hod@example.invalid","displayName":"Department HOD","firebaseUid":"existing-firebase-uid","department":"Engineering"}]
PGLMS_SEED_USERS_JSON=

# Sentry runtime and build integration
SENTRY_DSN=replace-me
NEXT_PUBLIC_SENTRY_DSN=replace-me
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=replace-me
SENTRY_PROJECT=replace-me
SENTRY_AUTH_TOKEN=replace-me
