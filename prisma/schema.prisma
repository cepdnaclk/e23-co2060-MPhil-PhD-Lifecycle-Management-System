generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  SUPERVISOR
  EXAMINER
  ADMINISTRATOR
}

enum ProgramType {
  MPHIL
  PHD
  MSC
  MENG
}

enum RegistrationStatus {
  ACTIVE
  LAPSED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ADMITTED
  REJECTED
}

enum ProposalStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ThesisStatus {
  SUBMITTED
  UNDER_EXAMINATION
  CORRECTIONS_REQUIRED
  FINAL_ARCHIVE
  CLOSED
}

enum VivaOutcome {
  PASS
  MINOR_CORRECTIONS
  MAJOR_CORRECTIONS
  FAIL
}

enum AcademicStatus {
  ACTIVE
  UNDER_REVIEW
  GRADUATED
  ARCHIVED
}

enum DocumentType {
  APPLICATION_ATTACHMENT
  PROPOSAL
  ETHICS_APPROVAL
  THESIS
  PROGRESS_REPORT
  CORRECTION
  REVIEW_ATTACHMENT
}

enum UploadPurpose {
  APPLICATION
  PROPOSAL
  ETHICS_APPROVAL
  PROGRESS_REPORT
  THESIS
  CORRECTION
  REVIEW_ATTACHMENT
}

enum UploadSessionStatus {
  OPEN
  FINALIZING
  FINALIZED
  ABORTED
  EXPIRED
  FAILED
}

enum UploadFileStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MalwareScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum DocumentVerificationStatus {
  LEGACY
  VERIFIED
}

enum DocumentAccessAction {
  LIST
  DOWNLOAD
}

enum DocumentAccessDecision {
  ALLOWED
  DENIED
}

enum NotificationEvent {
  APPLICATION_STATUS_CHANGED
  PROPOSAL_STATUS_CHANGED
  ETHICS_APPROVAL_SUBMITTED
  ETHICS_APPROVAL_STATUS_CHANGED
  PROGRESS_REPORT_SUBMITTED
  PROGRESS_REPORT_SIGNED_OFF
  SUPERVISOR_SUBMISSION_AVAILABLE
  EXAMINER_REVIEW_ASSIGNED
  EXAMINER_REVIEW_SUBMITTED
  ADMIN_REVIEW_RELEASED
  THESIS_DOWNLOADED
  REGISTRATION_EXPIRY_APPROACHING
  VIVA_SCHEDULED
  CORRECTIONS_REQUIRED
  THESIS_ARCHIVED
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum MaintenanceRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum CorrectionType {
  MINOR
  MAJOR
}

model User {
  id               String                @id @default(cuid())
  email            String                @unique
  displayName      String
  firebaseUid      String?               @unique
  role             UserRole
  isActive         Boolean               @default(true)
  student          Student?
  supervisor       Supervisor?
  examiner         Examiner?
  administrator    Administrator?
  notifications    Notification[]
  notificationLogs NotificationLog[]
  lifecycleEvents  LifecycleAuditEvent[] @relation("LifecycleAuditActor")
  outboxMessages   OutboxMessage[]       @relation("OutboxRecipient")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("users")
}

model Student {
  id                    String                        @id @default(cuid())
  userId                String                        @unique
  programType           ProgramType
  academicStatus        AcademicStatus                @default(ACTIVE)
  enrollmentDate        DateTime
  updatedBy             String?
  isArchived            Boolean                       @default(false)
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  application           Application?
  registrations         Registration[]
  researchProposals     ResearchProposal[]
  ethicsApprovals       EthicsApproval[]
  progressReports       ProgressReport[]
  theses                Thesis[]
  supervisorAssignments SupervisorAssignment[]
  examinerAssignments   ThesisExaminerAssignment[]
  reviewPanelAssignment ReviewPanelStudentAssignment?
  documents             Document[]
  notifications         Notification[]
  outboxMessages        OutboxMessage[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([academicStatus])
  @@map("students")
}

model Supervisor {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  department       String?
  specialization   String?
  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments      SupervisorAssignment[]
  panelMemberships PanelMembership[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("supervisors")
}

model Examiner {
  id                    String                     @id @default(cuid())
  userId                String                     @unique
  department            String?
  specialization        String?
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments           ThesisExaminerAssignment[]
  proposalEvaluations   EvaluationForm[]
  progressReportReviews ProgressReportReview[]
  panelEvaluations      PanelEvaluation[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@map("examiners")
}

model Administrator {
  id                              String                     @id @default(cuid())
  userId                          String                     @unique
  department                      String?
  user                            User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvals                       CorrectionDocument[]
  supervisorAssignments           SupervisorAssignment[]     @relation("SupervisorAssignmentsAssignedBy")
  thesisExaminerAssignments       ThesisExaminerAssignment[] @relation("ThesisExaminerAssignmentsAssignedBy")
  progressReportReviewAssignments ProgressReportReview[]     @relation("ProgressReportReviewAssignedBy")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt

  @@map("administrators")
}

model Application {
  id                 String            @id @default(cuid())
  applicantName      String
  applicantEmail     String
  applicantPhone     String?
  supervisor         String?
  researchArea       String?
  statementOfPurpose String?
  status             ApplicationStatus @default(SUBMITTED)
  programType        ProgramType
  studentId          String?           @unique
  isArchived         Boolean           @default(false)
  student            Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  researchProposal   ResearchProposal?
  documents          Document[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([applicantEmail])
  @@index([status])
  @@map("applications")
}

model Registration {
  id             String             @id @default(cuid())
  studentId      String
  startDate      DateTime
  expirationDate DateTime
  status         RegistrationStatus @default(ACTIVE)
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([studentId, status])
  @@map("registrations")
}

model ResearchProposal {
  id             String            @id @default(cuid())
  studentId      String
  applicationId  String            @unique
  title          String
  abstract       String
  status         ProposalStatus    @default(SUBMITTED)
  currentVersion Int               @default(1)
  isArchived     Boolean           @default(false)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluations    EvaluationForm[]
  versions       ProposalVersion[]
  documents      Document[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([studentId, status])
  @@map("research_proposals")
}

model ProposalVersion {
  id                 String           @id @default(cuid())
  researchProposalId String
  versionNumber      Int
  isCurrent          Boolean          @default(false)
  manifestHash       String
  submittedByUserId  String
  submittedAt        DateTime         @default(now())
  researchProposal   ResearchProposal @relation(fields: [researchProposalId], references: [id], onDelete: Cascade)
  evaluations        EvaluationForm[]
  documents          Document[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([researchProposalId, versionNumber])
  @@index([researchProposalId, isCurrent])
  @@map("proposal_versions")
}

model EvaluationForm {
  id                   String           @id @default(cuid())
  researchProposalId   String
  proposalVersionId    String?
  examinerId           String
  feedback             String
  evidenceManifestHash String?
  adminComments        String?
  releasedAt           DateTime?
  submissionDate       DateTime         @default(now())
  researchProposal     ResearchProposal @relation(fields: [researchProposalId], references: [id], onDelete: Cascade)
  proposalVersion      ProposalVersion? @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  examiner             Examiner         @relation(fields: [examinerId], references: [id], onDelete: Restrict)
  documents            Document[]

  @@unique([proposalVersionId, examinerId])
  @@index([proposalVersionId])
  @@map("evaluation_forms")
}

model EthicsApproval {
  id         String     @id @default(cuid())
  studentId  String
  title      String
  summary    String
  isArchived Boolean    @default(false)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents  Document[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([studentId, createdAt])
  @@map("ethics_approvals")
}

model SupervisorAssignment {
  id               String        @id @default(cuid())
  studentId        String
  supervisorId     String
  supervisorUserId String
  isPrimary        Boolean       @default(false)
  assignedAt       DateTime      @default(now())
  assignedBy       String
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supervisor       Supervisor    @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  administrator    Administrator @relation("SupervisorAssignmentsAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([studentId, supervisorId])
  @@unique([studentId, supervisorUserId])
  @@index([supervisorId])
  @@index([assignedBy])
  @@map("supervisor_assignments")
}

model ProgressReport {
  id                      String                 @id @default(cuid())
  studentId               String
  periodLabel             String
  narrative               String
  isSupervisorSignedOff   Boolean                @default(false)
  supervisorSignedOffAt   DateTime?
  supervisorSignedOffById String?
  isOverdue               Boolean                @default(false)
  isArchived              Boolean                @default(false)
  student                 Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  panelEvaluations        PanelEvaluation[]
  examinerReviews         ProgressReportReview[]
  documents               Document[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([studentId, periodLabel])
  @@index([studentId, isOverdue])
  @@map("progress_reports")
}

model ReviewPanel {
  id                 String                         @id @default(cuid())
  name               String
  description        String?
  cohortProgramType  ProgramType?
  memberships        PanelMembership[]
  studentAssignments ReviewPanelStudentAssignment[]
  evaluations        PanelEvaluation[]
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@map("review_panels")
}

model PanelMembership {
  id            String      @id @default(cuid())
  reviewPanelId String
  supervisorId  String
  reviewPanel   ReviewPanel @relation(fields: [reviewPanelId], references: [id], onDelete: Cascade)
  supervisor    Supervisor  @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([reviewPanelId, supervisorId])
  @@map("panel_memberships")
}

model PanelEvaluation {
  id               String         @id @default(cuid())
  reviewPanelId    String
  progressReportId String
  examinerId       String
  notes            String?
  submittedAt      DateTime?
  reviewPanel      ReviewPanel    @relation(fields: [reviewPanelId], references: [id], onDelete: Cascade)
  progressReport   ProgressReport @relation(fields: [progressReportId], references: [id], onDelete: Cascade)
  examiner         Examiner       @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([reviewPanelId, progressReportId, examinerId])
  @@index([progressReportId, examinerId])
  @@map("panel_evaluations")
}

model ProgressReportReview {
  id                   String         @id @default(cuid())
  progressReportId     String
  examinerId           String
  examinerUserId       String
  assignedAt           DateTime       @default(now())
  assignedBy           String
  reviewText           String?
  submittedAt          DateTime?
  adminComments        String?
  releasedAt           DateTime?
  evidenceManifestHash String?
  progressReport       ProgressReport @relation(fields: [progressReportId], references: [id], onDelete: Cascade)
  examiner             Examiner       @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  administrator        Administrator  @relation("ProgressReportReviewAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  documents            Document[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([progressReportId, examinerId])
  @@unique([progressReportId, examinerUserId])
  @@index([examinerId])
  @@index([assignedBy])
  @@map("progress_report_reviews")
}

model ReviewPanelStudentAssignment {
  id            String      @id @default(cuid())
  reviewPanelId String
  studentId     String      @unique
  reviewPanel   ReviewPanel @relation(fields: [reviewPanelId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([reviewPanelId, studentId])
  @@index([reviewPanelId])
  @@map("review_panel_student_assignments")
}

model Thesis {
  id                  String                     @id @default(cuid())
  studentId           String
  title               String
  abstract            String
  status              ThesisStatus               @default(SUBMITTED)
  isArchived          Boolean                    @default(false)
  student             Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examinerAssignments ThesisExaminerAssignment[]
  versions            ThesisVersion[]
  viva                Viva?
  corrections         CorrectionDocument[]
  documents           Document[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([studentId, status])
  @@map("theses")
}

model ThesisVersion {
  id                  String                     @id @default(cuid())
  thesisId            String
  versionNumber       Int
  isCurrent           Boolean                    @default(false)
  manifestHash        String
  submittedByUserId   String
  submittedAt         DateTime                   @default(now())
  thesis              Thesis                     @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  examinerAssignments ThesisExaminerAssignment[]
  documents           Document[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([thesisId, versionNumber])
  @@index([thesisId, isCurrent])
  @@map("thesis_versions")
}

model ThesisExaminerAssignment {
  id                   String         @id @default(cuid())
  thesisId             String
  thesisVersionId      String?
  studentId            String
  examinerId           String
  examinerUserId       String
  assignedAt           DateTime       @default(now())
  assignedBy           String
  reviewText           String?
  submittedAt          DateTime?
  adminComments        String?
  releasedAt           DateTime?
  evidenceManifestHash String?
  thesis               Thesis         @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  thesisVersion        ThesisVersion? @relation(fields: [thesisVersionId], references: [id], onDelete: Restrict)
  student              Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examiner             Examiner       @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  administrator        Administrator  @relation("ThesisExaminerAssignmentsAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  documents            Document[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([thesisId, examinerId])
  @@unique([studentId, examinerUserId])
  @@index([studentId, examinerId])
  @@index([thesisVersionId])
  @@index([assignedBy])
  @@map("thesis_examiner_assignments")
}

model Viva {
  id            String       @id @default(cuid())
  thesisId      String       @unique
  scheduledDate DateTime
  venue         String
  outcome       VivaOutcome?
  thesis        Thesis       @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("vivas")
}

model CorrectionDocument {
  id             String         @id @default(cuid())
  thesisId       String
  correctionType CorrectionType
  description    String?
  isApproved     Boolean        @default(false)
  approvedAt     DateTime?
  approvedById   String?
  thesis         Thesis         @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  approvedBy     Administrator? @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  documents      Document[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([thesisId, isApproved])
  @@map("correction_documents")
}

model Document {
  id                         String                     @id @default(cuid())
  documentType               DocumentType
  fileName                   String
  storagePath                String
  mimeType                   String
  sizeBytes                  Int?
  checksumSha256             String?
  verificationStatus         DocumentVerificationStatus @default(LEGACY)
  verifiedAt                 DateTime?
  version                    Int                        @default(1)
  isCurrentVersion           Boolean                    @default(true)
  isDeleted                  Boolean                    @default(false)
  applicationId              String?
  studentId                  String?
  researchProposalId         String?
  proposalVersionId          String?
  ethicsApprovalId           String?
  progressReportId           String?
  progressReportReviewId     String?
  thesisId                   String?
  thesisVersionId            String?
  thesisExaminerAssignmentId String?
  correctionDocumentId       String?
  evaluationFormId           String?
  application                Application?               @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  student                    Student?                   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  researchProposal           ResearchProposal?          @relation(fields: [researchProposalId], references: [id], onDelete: SetNull)
  proposalVersion            ProposalVersion?           @relation(fields: [proposalVersionId], references: [id], onDelete: SetNull)
  ethicsApproval             EthicsApproval?            @relation(fields: [ethicsApprovalId], references: [id], onDelete: SetNull)
  progressReport             ProgressReport?            @relation(fields: [progressReportId], references: [id], onDelete: SetNull)
  progressReportReview       ProgressReportReview?      @relation(fields: [progressReportReviewId], references: [id], onDelete: SetNull)
  thesis                     Thesis?                    @relation(fields: [thesisId], references: [id], onDelete: SetNull)
  thesisVersion              ThesisVersion?             @relation(fields: [thesisVersionId], references: [id], onDelete: SetNull)
  thesisExaminerAssignment   ThesisExaminerAssignment?  @relation(fields: [thesisExaminerAssignmentId], references: [id], onDelete: SetNull)
  correctionDocument         CorrectionDocument?        @relation(fields: [correctionDocumentId], references: [id], onDelete: SetNull)
  evaluationForm             EvaluationForm?            @relation(fields: [evaluationFormId], references: [id], onDelete: SetNull)
  stagedUploadFile           StagedUploadFile?
  accessEvents               DocumentAccessEvent[]
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@index([documentType, isDeleted])
  @@index([researchProposalId, version])
  @@index([proposalVersionId])
  @@index([ethicsApprovalId])
  @@index([progressReportReviewId])
  @@index([thesisId, version])
  @@index([thesisVersionId])
  @@index([thesisExaminerAssignmentId])
  @@index([evaluationFormId])
  @@map("documents")
}

model UploadSession {
  id                  String              @id @default(cuid())
  ownerUserId         String?
  capabilityTokenHash String?             @unique
  purpose             UploadPurpose
  status              UploadSessionStatus @default(OPEN)
  idempotencyKey      String              @unique
  expiresAt           DateTime
  finalizedAt         DateTime?
  finalizedEntityId   String?
  result              Json?
  abortedAt           DateTime?
  failureReason       String?
  requestCount        Int                 @default(0)
  lastRequestAt       DateTime?
  files               StagedUploadFile[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([ownerUserId, status])
  @@index([status, expiresAt])
  @@map("upload_sessions")
}

model StagedUploadFile {
  id                String            @id @default(cuid())
  uploadSessionId   String
  ordinal           Int
  fileName          String
  expectedMimeType  String
  expectedSizeBytes Int
  expectedSha256    String?
  storagePath       String            @unique
  actualMimeType    String?
  actualSizeBytes   Int?
  actualSha256      String?
  status            UploadFileStatus  @default(PENDING)
  malwareScanStatus MalwareScanStatus @default(PENDING)
  verifiedAt        DateTime?
  rejectionReason   String?
  documentId        String?           @unique
  uploadSession     UploadSession     @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)
  document          Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([uploadSessionId, ordinal])
  @@index([uploadSessionId, status])
  @@map("staged_upload_files")
}

model DocumentAccessEvent {
  id                 String                 @id @default(cuid())
  actorUserId        String
  actorRole          UserRole
  documentId         String
  action             DocumentAccessAction
  decision           DocumentAccessDecision
  reasonCode         String
  storagePathHash    String
  signedUrlExpiresAt DateTime?
  occurredAt         DateTime               @default(now())
  document           Document               @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([documentId, occurredAt])
  @@map("document_access_events")
}

model DocumentMigrationIssue {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  reason     String
  details    Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([resolvedAt, createdAt])
  @@map("document_migration_issues")
}

model PublicRequestRateLimit {
  keyHash      String   @id
  windowStart  DateTime
  requestCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([windowStart])
  @@map("public_request_rate_limits")
}

model Notification {
  id              String            @id @default(cuid())
  recipientId     String
  studentId       String?
  event           NotificationEvent
  title           String
  message         String
  actionUrl       String?
  outboxMessageId String?           @unique
  isRead          Boolean           @default(false)
  recipient       User              @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  student         Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  outboxMessage   OutboxMessage?    @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([recipientId, isRead])
  @@map("notifications")
}

model LifecycleAuditEvent {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  eventType     String
  aggregateType String
  aggregateId   String
  actorUserId   String?
  actorRole     String?
  actorLabel    String?
  previousState String?
  newState      String?
  metadata      Json?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  actor         User?    @relation("LifecycleAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("lifecycle_audit_events")
}

model OutboxMessage {
  id                String                  @id @default(cuid())
  eventKey          String                  @unique
  topic             String
  recipientId       String?
  studentId         String?
  notificationEvent NotificationEvent?
  title             String?
  message           String?
  actionUrl         String?
  payload           Json
  status            OutboxStatus            @default(PENDING)
  attempts          Int                     @default(0)
  maxAttempts       Int                     @default(5)
  availableAt       DateTime                @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  lastError         String?
  deliveredAt       DateTime?
  recipient         User?                   @relation("OutboxRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  student           Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)
  notification      Notification?
  deliveryAttempts  OutboxDeliveryAttempt[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([recipientId, createdAt])
  @@index([topic, createdAt])
  @@map("outbox_messages")
}

model OutboxDeliveryAttempt {
  id           String        @id @default(cuid())
  outboxId     String
  attempt      Int
  succeeded    Boolean
  errorMessage String?
  startedAt    DateTime      @default(now())
  completedAt  DateTime      @default(now())
  outbox       OutboxMessage @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@unique([outboxId, attempt])
  @@index([succeeded, completedAt])
  @@map("outbox_delivery_attempts")
}

model NotificationLog {
  id             String                     @id @default(cuid())
  recipientId    String
  event          NotificationEvent
  subject        String
  deliveryStatus NotificationDeliveryStatus
  failureReason  String?
  metadata       Json?
  recipient      User                       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([recipientId, deliveryStatus])
  @@index([event, createdAt])
  @@map("notification_logs")
}

model MaintenanceRun {
  id           String               @id @default(cuid())
  jobName      String
  runKey       String
  status       MaintenanceRunStatus @default(RUNNING)
  result       Json?
  errorMessage String?
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  failedAt     DateTime?
  updatedAt    DateTime             @updatedAt

  @@unique([jobName, runKey])
  @@index([status, startedAt])
  @@map("maintenance_runs")
}
