generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  SUPERVISOR
  EXAMINER
  ADMINISTRATOR
  HOD
}

enum ProgramType {
  MPHIL
  PHD
}

enum StudyMode {
  FULL_TIME
  PART_TIME
}

enum SupervisorConsentStatus {
  PENDING
  CONSENTED
  DECLINED
  WITHDRAWN
}

enum DepartmentDecision {
  PENDING
  APPROVED
  REVISION_REQUIRED
  REJECTED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  SCHEDULED
  DUE
  SUBMITTED
  RETURNED
  APPROVED
  OVERDUE
  WAIVED
}

enum ProgressSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

enum EthicsApplicability {
  UNDETERMINED
  REQUIRED
  NOT_REQUIRED
}

enum EthicsRecordStatus {
  NOT_RECORDED
  PENDING
  APPROVED
  EXEMPT
  REJECTED
  EXPIRED
}

enum EthicsWorkflowStage {
  STUDENT_DECLARATION
  SUPERVISOR_RECOMMENDATION
  COORDINATOR_RECORD
  HOD_CONFIRMATION
  COMPLETED
}

enum EthicsWorkflowAction {
  STUDENT_DECLARED_REQUIRED
  STUDENT_DECLARED_NOT_REQUIRED
  STUDENT_RESUBMITTED
  SUPERVISOR_RECOMMENDED
  SUPERVISOR_RETURNED
  COORDINATOR_RECORDED
  COORDINATOR_RETURNED
  HOD_CONFIRMED
  HOD_RETURNED
  HOD_REJECTED
}

enum ReadinessDecision {
  PENDING
  REQUESTED
  CERTIFIED
  HOD_APPROVED
  RETURNED
  REVOKED
}

enum ExaminerRecommendation {
  PASS
  MINOR_CORRECTIONS
  MAJOR_CORRECTIONS
  RESUBMIT
  FAIL
}

enum CorrectionOrderStatus {
  ORDERED
  SUBMITTED
  RETURNED
  SUPERVISOR_CERTIFIED
  EXAMINER_APPROVED
  COMPLETION_APPROVED
}

enum CorrectionReviewStage {
  SUPERVISOR
  EXAMINER
}

enum CorrectionReviewDecision {
  CERTIFIED
  APPROVED
  RETURNED
}

enum CompletionStatus {
  PENDING
  HOD_APPROVED
  COMPLETED
}

enum GraduationStatus {
  NOT_RECORDED
  GRADUATED
}

enum ArchiveStatus {
  ACTIVE
  ARCHIVED
}

enum RegistrationStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ADMITTED
  REJECTED
}

enum ProposalStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ThesisStatus {
  SUBMITTED
  UNDER_EXAMINATION
  CORRECTIONS_REQUIRED
  CORRECTIONS_APPROVED
  COMPLETED
  ARCHIVED
  CLOSED
}

enum VivaOutcome {
  PASS
  MINOR_CORRECTIONS
  MAJOR_CORRECTIONS
  FAIL
}

enum AcademicStatus {
  ACTIVE
  UNDER_REVIEW
  COMPLETED
  GRADUATED
  ARCHIVED
  FAILED
}

enum DocumentType {
  APPLICATION_ATTACHMENT
  PROPOSAL
  ETHICS_APPROVAL
  THESIS
  PROGRESS_REPORT
  CORRECTION
  REVIEW_ATTACHMENT
}

enum UploadPurpose {
  APPLICATION
  PROPOSAL
  ETHICS_APPROVAL
  PROGRESS_REPORT
  THESIS
  CORRECTION
  REVIEW_ATTACHMENT
}

enum UploadSessionStatus {
  OPEN
  FINALIZING
  FINALIZED
  ABORTED
  EXPIRED
  FAILED
}

enum UploadFileStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MalwareScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum DocumentVerificationStatus {
  LEGACY
  VERIFIED
}

enum DocumentAccessAction {
  LIST
  DOWNLOAD
}

enum DocumentAccessDecision {
  ALLOWED
  DENIED
}

enum NotificationEvent {
  APPLICATION_STATUS_CHANGED
  PROPOSAL_STATUS_CHANGED
  ETHICS_APPROVAL_SUBMITTED
  ETHICS_APPROVAL_STATUS_CHANGED
  PROGRESS_REPORT_SUBMITTED
  SUPERVISOR_SUBMISSION_AVAILABLE
  EXAMINER_REVIEW_ASSIGNED
  EXAMINER_REVIEW_SUBMITTED
  ADMIN_REVIEW_RELEASED
  THESIS_DOWNLOADED
  THESIS_STATUS_CHANGED
  VIVA_SCHEDULED
  CORRECTIONS_REQUIRED
  PROGRAMME_COMPLETION_STATUS_CHANGED
  GRADUATION_RECORDED
  RECORD_ARCHIVED
  THESIS_ARCHIVED
  SYSTEM_NOTICE
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

enum MaintenanceRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum CorrectionType {
  MINOR
  MAJOR
}

model User {
  id                              String                         @id @default(cuid())
  email                           String                         @unique
  displayName                     String
  firebaseUid                     String?                        @unique
  role                            UserRole
  isActive                        Boolean                        @default(true)
  student                         Student?
  supervisor                      Supervisor?
  examiner                        Examiner?
  administrator                   Administrator?
  hod                             Hod?
  proposedApplications            Application[]                  @relation("ProposedSupervisorUser")
  hodDecidedApplications          Application[]                  @relation("ApplicationHodDecision")
  proposalReviewerAssignments     ProposalReviewerAssignment[]   @relation("ProposalReviewerUser")
  readinessCertifications         ThesisReadinessCertification[] @relation("ReadinessCertifier")
  readinessApprovals              ThesisReadinessCertification[] @relation("ReadinessHodApprover")
  hodConfirmedExaminerAssignments ThesisExaminerAssignment[]     @relation("ExaminerAssignmentHod")
  examinerReports                 ThesisExaminerReport[]         @relation("ExaminerReportAuthor")
  vivaRecommendations             VivaRecommendation[]           @relation("VivaRecommendationAuthor")
  hodDecidedVivas                 Viva[]                         @relation("VivaHodDecision")
  correctionOrders                CorrectionOrder[]              @relation("CorrectionOrderHod")
  correctionApprovals             CorrectionOrder[]              @relation("CorrectionApprovalHod")
  correctionSubmissions           CorrectionSubmission[]         @relation("CorrectionSubmissionSubmitter")
  correctionReviews               CorrectionReview[]             @relation("CorrectionReviewReviewer")
  completionApprovals             ProgrammeCompletion[]          @relation("CompletionHod")
  completionRecordings            ProgrammeCompletion[]          @relation("CompletionAdministrator")
  graduationRecords               GraduationRecord[]             @relation("GraduationRecorder")
  archiveRecords                  StudentArchiveRecord[]         @relation("ArchiveRecorder")
  ethicsWorkflowDecisions         EthicsWorkflowDecision[]       @relation("EthicsDecisionActor")
  admissionExecutions             AdmissionExecution[]           @relation("AdmissionExecutor")
  notifications                   Notification[]
  notificationLogs                NotificationLog[]
  lifecycleEvents                 LifecycleAuditEvent[]          @relation("LifecycleAuditActor")
  outboxMessages                  OutboxMessage[]                @relation("OutboxRecipient")
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt

  @@map("users")
}

model Student {
  id                      String                         @id @default(cuid())
  userId                  String                         @unique
  programType             ProgramType
  studyMode               StudyMode                      @default(FULL_TIME)
  academicStatus          AcademicStatus                 @default(ACTIVE)
  enrollmentDate          DateTime
  expectedCompletionDate  DateTime?
  updatedBy               String?
  isArchived              Boolean                        @default(false)
  user                    User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  application             Application?
  registrations           Registration[]
  researchProposals       ResearchProposal[]
  ethicsApprovals         EthicsApproval[]
  progressReports         ProgressReport[]
  theses                  Thesis[]
  supervisorAssignments   SupervisorAssignment[]
  examinerAssignments     ThesisExaminerAssignment[]
  documents               Document[]
  notifications           Notification[]
  milestones              StudentMilestone[]
  readinessCertifications ThesisReadinessCertification[]
  programmeCompletion     ProgrammeCompletion?
  graduationRecord        GraduationRecord?
  archiveRecord           StudentArchiveRecord?
  admissionExecution      AdmissionExecution?
  outboxMessages          OutboxMessage[]
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  @@index([academicStatus])
  @@map("students")
}

model Supervisor {
  id                   String                 @id @default(cuid())
  userId               String                 @unique
  department           String?
  specialization       String?
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments          SupervisorAssignment[]
  proposedApplications Application[]          @relation("ProposedSupervisorProfile")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@map("supervisors")
}

model Examiner {
  id                  String                     @id @default(cuid())
  userId              String                     @unique
  department          String?
  specialization      String?
  user                User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments         ThesisExaminerAssignment[]
  proposalEvaluations EvaluationForm[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@map("examiners")
}

model Administrator {
  id                        String                     @id @default(cuid())
  userId                    String                     @unique
  department                String?
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvals                 CorrectionDocument[]
  supervisorAssignments     SupervisorAssignment[]     @relation("SupervisorAssignmentsAssignedBy")
  thesisExaminerAssignments ThesisExaminerAssignment[] @relation("ThesisExaminerAssignmentsAssignedBy")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@map("administrators")
}

model Hod {
  id         String   @id @default(cuid())
  userId     String   @unique
  department String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("hods")
}

model Application {
  id                          String                       @id @default(cuid())
  applicantName               String
  applicantEmail              String
  applicantPhone              String?
  supervisor                  String?
  researchArea                String?
  statementOfPurpose          String?
  status                      ApplicationStatus            @default(SUBMITTED)
  programType                 ProgramType
  studyMode                   StudyMode                    @default(FULL_TIME)
  proposalTitle               String?
  proposalAbstract            String?
  proposedSupervisorId        String?
  proposedSupervisorUserId    String?
  supervisorConsentStatus     SupervisorConsentStatus      @default(PENDING)
  supervisorConsentRecordedAt DateTime?
  departmentDecision          DepartmentDecision           @default(PENDING)
  hodDecisionByUserId         String?
  hodDecisionAt               DateTime?
  hodDecisionReason           String?
  revisionCapabilityTokenHash String?                      @unique
  revisionCapabilityExpiresAt DateTime?
  studentId                   String?                      @unique
  isArchived                  Boolean                      @default(false)
  student                     Student?                     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  researchProposal            ResearchProposal?
  proposalVersions            ApplicationProposalVersion[]
  proposalReviewerAssignments ProposalReviewerAssignment[]
  admissionExecution          AdmissionExecution?
  proposedSupervisor          Supervisor?                  @relation("ProposedSupervisorProfile", fields: [proposedSupervisorId], references: [id], onDelete: SetNull)
  proposedSupervisorUser      User?                        @relation("ProposedSupervisorUser", fields: [proposedSupervisorUserId], references: [id], onDelete: SetNull)
  hodDecisionBy               User?                        @relation("ApplicationHodDecision", fields: [hodDecisionByUserId], references: [id], onDelete: SetNull)
  documents                   Document[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@index([applicantEmail])
  @@index([status])
  @@index([departmentDecision, createdAt])
  @@index([proposedSupervisorUserId, supervisorConsentStatus])
  @@map("applications")
}

model ApplicationProposalVersion {
  id                  String                       @id @default(cuid())
  applicationId       String
  versionNumber       Int
  title               String
  abstract            String
  changeSummary       String?
  isCurrent           Boolean                      @default(false)
  submittedAt         DateTime                     @default(now())
  application         Application                  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerAssignments ProposalReviewerAssignment[]
  reviews             ProposalReview[]
  documents           Document[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([applicationId, versionNumber])
  @@index([applicationId, isCurrent])
  @@map("application_proposal_versions")
}

model ProposalReviewerAssignment {
  id                String                     @id @default(cuid())
  applicationId     String
  proposalVersionId String
  reviewerUserId    String
  assignedByUserId  String
  status            AssignmentStatus           @default(PENDING)
  assignedAt        DateTime                   @default(now())
  respondedAt       DateTime?
  completedAt       DateTime?
  application       Application                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  proposalVersion   ApplicationProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  reviewer          User                       @relation("ProposalReviewerUser", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  review            ProposalReview?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([proposalVersionId, reviewerUserId])
  @@index([reviewerUserId, status, assignedAt])
  @@index([applicationId, status])
  @@map("proposal_reviewer_assignments")
}

model ProposalReview {
  id                String                     @id @default(cuid())
  assignmentId      String                     @unique
  proposalVersionId String
  decision          DepartmentDecision
  comments          String
  submittedAt       DateTime                   @default(now())
  assignment        ProposalReviewerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  proposalVersion   ApplicationProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  createdAt         DateTime                   @default(now())

  @@index([proposalVersionId, submittedAt])
  @@map("proposal_reviews")
}

model AdmissionExecution {
  id               String       @id @default(cuid())
  applicationId    String       @unique
  executedByUserId String
  studentId        String       @unique
  registrationId   String       @unique
  executedAt       DateTime     @default(now())
  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  executedBy       User         @relation("AdmissionExecutor", fields: [executedByUserId], references: [id], onDelete: Restrict)
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@index([executedByUserId, executedAt])
  @@map("admission_executions")
}

model ProgrammeRule {
  id                      String      @id @default(cuid())
  programType             ProgramType
  studyMode               StudyMode
  durationMonths          Int
  milestoneIntervalMonths Int         @default(6)
  milestoneCount          Int
  isActive                Boolean     @default(true)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@unique([programType, studyMode])
  @@map("programme_rules")
}

model Registration {
  id                     String              @id @default(cuid())
  studentId              String              @unique
  startDate              DateTime
  expectedCompletionDate DateTime
  status                 RegistrationStatus  @default(ACTIVE)
  completedAt            DateTime?
  archivedAt             DateTime?
  student                Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admissionExecution     AdmissionExecution?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([status])
  @@map("registrations")
}

model StudentMilestone {
  id             String          @id @default(cuid())
  studentId      String
  sequenceNumber Int
  dueDate        DateTime
  status         MilestoneStatus @default(SCHEDULED)
  openedAt       DateTime?
  completedAt    DateTime?
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progressReport ProgressReport?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([studentId, sequenceNumber])
  @@index([status, dueDate])
  @@map("student_milestones")
}

model ResearchProposal {
  id             String            @id @default(cuid())
  studentId      String
  applicationId  String            @unique
  title          String
  abstract       String
  status         ProposalStatus    @default(SUBMITTED)
  currentVersion Int               @default(1)
  isArchived     Boolean           @default(false)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluations    EvaluationForm[]
  versions       ProposalVersion[]
  documents      Document[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([studentId, status])
  @@map("research_proposals")
}

model ProposalVersion {
  id                 String           @id @default(cuid())
  researchProposalId String
  versionNumber      Int
  isCurrent          Boolean          @default(false)
  manifestHash       String
  submittedByUserId  String
  submittedAt        DateTime         @default(now())
  researchProposal   ResearchProposal @relation(fields: [researchProposalId], references: [id], onDelete: Cascade)
  evaluations        EvaluationForm[]
  documents          Document[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([researchProposalId, versionNumber])
  @@index([researchProposalId, isCurrent])
  @@map("proposal_versions")
}

model EvaluationForm {
  id                   String           @id @default(cuid())
  researchProposalId   String
  proposalVersionId    String?
  examinerId           String
  feedback             String
  evidenceManifestHash String?
  adminComments        String?
  releasedAt           DateTime?
  submissionDate       DateTime         @default(now())
  researchProposal     ResearchProposal @relation(fields: [researchProposalId], references: [id], onDelete: Cascade)
  proposalVersion      ProposalVersion? @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  examiner             Examiner         @relation(fields: [examinerId], references: [id], onDelete: Restrict)
  documents            Document[]

  @@unique([proposalVersionId, examinerId])
  @@index([proposalVersionId])
  @@map("evaluation_forms")
}

model EthicsApproval {
  id                        String                   @id @default(cuid())
  studentId                 String
  title                     String
  summary                   String
  applicability             EthicsApplicability      @default(UNDETERMINED)
  status                    EthicsRecordStatus       @default(NOT_RECORDED)
  workflowStage             EthicsWorkflowStage      @default(STUDENT_DECLARATION)
  revisionNumber            Int                      @default(1)
  coordinatorProposedStatus EthicsRecordStatus?
  applicabilityRecordedBy   String?
  applicabilityRecordedAt   DateTime?
  studentDeclaredAt         DateTime?
  supervisorRecommendedAt   DateTime?
  coordinatorRecordedAt     DateTime?
  hodConfirmedAt            DateTime?
  statusRecordedBy          String?
  statusRecordedAt          DateTime?
  referenceNumber           String?
  validUntil                DateTime?
  notes                     String?
  isArchived                Boolean                  @default(false)
  student                   Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents                 Document[]
  decisionHistory           EthicsWorkflowDecision[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([studentId, createdAt])
  @@index([applicability, status])
  @@map("ethics_approvals")
}

model EthicsWorkflowDecision {
  id               String               @id @default(cuid())
  ethicsApprovalId String
  stage            EthicsWorkflowStage
  action           EthicsWorkflowAction
  actorUserId      String
  notes            String?
  metadata         Json?
  createdAt        DateTime             @default(now())
  ethicsApproval   EthicsApproval       @relation(fields: [ethicsApprovalId], references: [id], onDelete: Cascade)
  actor            User                 @relation("EthicsDecisionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ethicsApprovalId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("ethics_workflow_decisions")
}

model SupervisorAssignment {
  id               String        @id @default(cuid())
  studentId        String
  supervisorId     String
  supervisorUserId String
  isPrimary        Boolean       @default(false)
  assignedAt       DateTime      @default(now())
  effectiveFrom    DateTime      @default(now())
  effectiveTo      DateTime?
  endReason        String?
  assignedBy       String
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supervisor       Supervisor    @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  administrator    Administrator @relation("SupervisorAssignmentsAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([studentId, effectiveFrom, effectiveTo])
  @@index([supervisorId])
  @@index([assignedBy])
  @@map("supervisor_assignments")
}

model ProgressReport {
  id               String                   @id @default(cuid())
  studentId        String
  milestoneId      String?                  @unique
  periodLabel      String
  narrative        String
  status           ProgressSubmissionStatus @default(DRAFT)
  currentVersion   Int                      @default(1)
  submittedAt      DateTime?
  returnedAt       DateTime?
  returnedByUserId String?
  returnReason     String?
  approvedAt       DateTime?
  approvedByUserId String?
  isOverdue        Boolean                  @default(false)
  isArchived       Boolean                  @default(false)
  student          Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestone        StudentMilestone?        @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  versions         ProgressReportVersion[]
  documents        Document[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([studentId, periodLabel])
  @@index([studentId, isOverdue])
  @@map("progress_reports")
}

model ProgressReportVersion {
  id                String         @id @default(cuid())
  progressReportId  String
  versionNumber     Int
  narrative         String
  changeSummary     String?
  submittedByUserId String
  submittedAt       DateTime       @default(now())
  progressReport    ProgressReport @relation(fields: [progressReportId], references: [id], onDelete: Cascade)
  documents         Document[]
  createdAt         DateTime       @default(now())

  @@unique([progressReportId, versionNumber])
  @@index([submittedByUserId, submittedAt])
  @@map("progress_report_versions")
}

model Thesis {
  id                     String                        @id @default(cuid())
  studentId              String
  title                  String
  abstract               String
  status                 ThesisStatus                  @default(SUBMITTED)
  isArchived             Boolean                       @default(false)
  student                Student                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  readinessCertification ThesisReadinessCertification?
  examinerAssignments    ThesisExaminerAssignment[]
  versions               ThesisVersion[]
  viva                   Viva?
  corrections            CorrectionDocument[]
  documents              Document[]
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  correctionOrders       CorrectionOrder[]
  programmeCompletion    ProgrammeCompletion?

  @@index([studentId, status])
  @@map("theses")
}

model ThesisReadinessCertification {
  id                  String            @id @default(cuid())
  thesisId            String?           @unique
  studentId           String            @unique
  certifiedByUserId   String?
  hodApprovedByUserId String?
  decision            ReadinessDecision @default(PENDING)
  studentMessage      String?
  checklist           Json?
  supervisorNotes     String?
  certifiedAt         DateTime?
  hodNotes            String?
  hodApprovedAt       DateTime?
  decidedAt           DateTime?
  thesis              Thesis?           @relation(fields: [thesisId], references: [id], onDelete: SetNull)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certifiedBy         User?             @relation("ReadinessCertifier", fields: [certifiedByUserId], references: [id], onDelete: SetNull)
  hodApprovedBy       User?             @relation("ReadinessHodApprover", fields: [hodApprovedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([studentId, decision])
  @@index([certifiedByUserId, createdAt])
  @@index([hodApprovedByUserId, hodApprovedAt])
  @@map("thesis_readiness_certifications")
}

model ThesisVersion {
  id                          String                     @id @default(cuid())
  thesisId                    String
  versionNumber               Int
  isCurrent                   Boolean                    @default(false)
  manifestHash                String
  submittedByUserId           String
  submittedAt                 DateTime                   @default(now())
  thesis                      Thesis                     @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  examinerAssignments         ThesisExaminerAssignment[]
  originatingCorrectionOrders CorrectionOrder[]          @relation("CorrectionOriginVersion")
  correctionSubmissions       CorrectionSubmission[]     @relation("CorrectionRevisedVersion")
  programmeCompletion         ProgrammeCompletion?
  documents                   Document[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@unique([thesisId, versionNumber])
  @@index([thesisId, isCurrent])
  @@map("thesis_versions")
}

model ThesisExaminerAssignment {
  id                   String                @id @default(cuid())
  thesisId             String
  thesisVersionId      String?
  studentId            String
  examinerId           String
  examinerUserId       String
  assignedAt           DateTime              @default(now())
  assignedBy           String
  status               AssignmentStatus      @default(PENDING)
  confirmedByHodUserId String?
  confirmedAt          DateTime?
  endedAt              DateTime?
  reviewText           String?
  submittedAt          DateTime?
  adminComments        String?
  releasedAt           DateTime?
  evidenceManifestHash String?
  thesis               Thesis                @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  thesisVersion        ThesisVersion?        @relation(fields: [thesisVersionId], references: [id], onDelete: Restrict)
  student              Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examiner             Examiner              @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  administrator        Administrator         @relation("ThesisExaminerAssignmentsAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)
  confirmedByHod       User?                 @relation("ExaminerAssignmentHod", fields: [confirmedByHodUserId], references: [id], onDelete: SetNull)
  report               ThesisExaminerReport?
  vivaRecommendation   VivaRecommendation?
  correctionReviews    CorrectionReview[]
  documents            Document[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([thesisId, examinerId])
  @@unique([studentId, examinerUserId])
  @@index([studentId, examinerId])
  @@index([thesisVersionId])
  @@index([assignedBy])
  @@index([status, confirmedAt])
  @@map("thesis_examiner_assignments")
}

model ThesisExaminerReport {
  id             String                   @id @default(cuid())
  assignmentId   String                   @unique
  authorUserId   String
  recommendation ExaminerRecommendation
  reportText     String
  submittedAt    DateTime                 @default(now())
  assignment     ThesisExaminerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  author         User                     @relation("ExaminerReportAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([authorUserId, submittedAt])
  @@map("thesis_examiner_reports")
}

model Viva {
  id                    String                  @id @default(cuid())
  thesisId              String                  @unique
  scheduledDate         DateTime
  venue                 String
  outcome               VivaOutcome?
  hodOutcome            ExaminerRecommendation?
  hodDecisionByUserId   String?
  hodDecisionAt         DateTime?
  hodDecisionReason     String?
  thesis                Thesis                  @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  hodDecisionBy         User?                   @relation("VivaHodDecision", fields: [hodDecisionByUserId], references: [id], onDelete: SetNull)
  recommendations       VivaRecommendation[]
  correctionOrders      CorrectionOrder[]
  programmeCompletion   ProgrammeCompletion?    @relation(fields: [programmeCompletionId], references: [id])
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  programmeCompletionId String?

  @@map("vivas")
}

model VivaRecommendation {
  id             String                   @id @default(cuid())
  vivaId         String
  assignmentId   String                   @unique
  authorUserId   String
  recommendation ExaminerRecommendation
  rationale      String
  submittedAt    DateTime                 @default(now())
  viva           Viva                     @relation(fields: [vivaId], references: [id], onDelete: Cascade)
  assignment     ThesisExaminerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  author         User                     @relation("VivaRecommendationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime                 @default(now())

  @@index([vivaId, submittedAt])
  @@index([authorUserId, submittedAt])
  @@map("viva_recommendations")
}

model CorrectionOrder {
  id                         String                 @id @default(cuid())
  vivaId                     String
  thesisId                   String
  originatingThesisVersionId String?
  orderedByHodUserId         String
  requirementType            CorrectionType
  requiresExaminerReview     Boolean                @default(false)
  requirements               String
  dueDate                    DateTime?
  status                     CorrectionOrderStatus  @default(ORDERED)
  completionApprovedBy       String?
  completionApprovedAt       DateTime?
  completionNotes            String?
  viva                       Viva                   @relation(fields: [vivaId], references: [id], onDelete: Restrict)
  thesis                     Thesis                 @relation(fields: [thesisId], references: [id], onDelete: Restrict)
  originatingThesisVersion   ThesisVersion?         @relation("CorrectionOriginVersion", fields: [originatingThesisVersionId], references: [id], onDelete: Restrict)
  orderedByHod               User                   @relation("CorrectionOrderHod", fields: [orderedByHodUserId], references: [id], onDelete: Restrict)
  completionApprovedByHod    User?                  @relation("CorrectionApprovalHod", fields: [completionApprovedBy], references: [id], onDelete: SetNull)
  submissions                CorrectionSubmission[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([thesisId, status])
  @@index([originatingThesisVersionId])
  @@index([orderedByHodUserId, createdAt])
  @@map("correction_orders")
}

model CorrectionSubmission {
  id                     String             @id @default(cuid())
  correctionOrderId      String
  revisedThesisVersionId String?
  versionNumber          Int
  responseSummary        String
  manifestHash           String?
  submittedByUserId      String
  submittedAt            DateTime           @default(now())
  returnedAt             DateTime?
  returnReason           String?
  correctionOrder        CorrectionOrder    @relation(fields: [correctionOrderId], references: [id], onDelete: Cascade)
  revisedThesisVersion   ThesisVersion?     @relation("CorrectionRevisedVersion", fields: [revisedThesisVersionId], references: [id], onDelete: Restrict)
  submittedBy            User               @relation("CorrectionSubmissionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  documents              Document[]
  reviews                CorrectionReview[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([correctionOrderId, versionNumber])
  @@unique([revisedThesisVersionId])
  @@index([submittedByUserId, submittedAt])
  @@map("correction_submissions")
}

model CorrectionReview {
  id                         String                    @id @default(cuid())
  correctionSubmissionId     String
  stage                      CorrectionReviewStage
  decision                   CorrectionReviewDecision
  reviewerUserId             String
  thesisExaminerAssignmentId String?
  notes                      String?
  createdAt                  DateTime                  @default(now())
  correctionSubmission       CorrectionSubmission      @relation(fields: [correctionSubmissionId], references: [id], onDelete: Cascade)
  reviewer                   User                      @relation("CorrectionReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  thesisExaminerAssignment   ThesisExaminerAssignment? @relation(fields: [thesisExaminerAssignmentId], references: [id], onDelete: Restrict)

  @@unique([correctionSubmissionId, stage, reviewerUserId])
  @@unique([correctionSubmissionId, thesisExaminerAssignmentId])
  @@index([reviewerUserId, createdAt])
  @@map("correction_reviews")
}

model CorrectionDocument {
  id             String         @id @default(cuid())
  thesisId       String
  correctionType CorrectionType
  description    String?
  isApproved     Boolean        @default(false)
  approvedAt     DateTime?
  approvedById   String?
  thesis         Thesis         @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  approvedBy     Administrator? @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  documents      Document[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([thesisId, isApproved])
  @@map("correction_documents")
}

model ProgrammeCompletion {
  id                    String           @id @default(cuid())
  studentId             String           @unique
  thesisId              String           @unique
  thesisVersionId       String           @unique
  status                CompletionStatus @default(PENDING)
  approvedByHodUserId   String?
  hodApprovedAt         DateTime?
  hodComments           String?
  recordedByAdminUserId String?
  adminRecordedAt       DateTime?
  completedAt           DateTime?
  student               Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  thesis                Thesis           @relation(fields: [thesisId], references: [id], onDelete: Restrict)
  thesisVersion         ThesisVersion    @relation(fields: [thesisVersionId], references: [id], onDelete: Restrict)
  approvedByHod         User?            @relation("CompletionHod", fields: [approvedByHodUserId], references: [id], onDelete: SetNull)
  recordedByAdmin       User?            @relation("CompletionAdministrator", fields: [recordedByAdminUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  Viva                  Viva[]

  @@index([status, createdAt])
  @@map("programme_completions")
}

model GraduationRecord {
  id                    String           @id @default(cuid())
  studentId             String           @unique
  status                GraduationStatus @default(NOT_RECORDED)
  graduationDate        DateTime?
  confirmationReference String
  recordedByUserId      String
  notes                 String?
  student               Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy            User             @relation("GraduationRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status, graduationDate])
  @@map("graduation_records")
}

model StudentArchiveRecord {
  id               String        @id @default(cuid())
  studentId        String        @unique
  status           ArchiveStatus @default(ACTIVE)
  archivedAt       DateTime?
  archivedByUserId String
  reason           String?
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  archivedBy       User          @relation("ArchiveRecorder", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, archivedAt])
  @@map("student_archive_records")
}

model Document {
  id                           String                      @id @default(cuid())
  documentType                 DocumentType
  fileName                     String
  storagePath                  String
  mimeType                     String
  sizeBytes                    Int?
  checksumSha256               String?
  verificationStatus           DocumentVerificationStatus  @default(LEGACY)
  verifiedAt                   DateTime?
  version                      Int                         @default(1)
  isCurrentVersion             Boolean                     @default(true)
  isDeleted                    Boolean                     @default(false)
  applicationId                String?
  studentId                    String?
  researchProposalId           String?
  proposalVersionId            String?
  ethicsApprovalId             String?
  progressReportId             String?
  thesisId                     String?
  thesisVersionId              String?
  thesisExaminerAssignmentId   String?
  correctionDocumentId         String?
  correctionSubmissionId       String?
  evaluationFormId             String?
  applicationProposalVersionId String?
  progressReportVersionId      String?
  application                  Application?                @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  student                      Student?                    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  researchProposal             ResearchProposal?           @relation(fields: [researchProposalId], references: [id], onDelete: SetNull)
  proposalVersion              ProposalVersion?            @relation(fields: [proposalVersionId], references: [id], onDelete: SetNull)
  ethicsApproval               EthicsApproval?             @relation(fields: [ethicsApprovalId], references: [id], onDelete: SetNull)
  progressReport               ProgressReport?             @relation(fields: [progressReportId], references: [id], onDelete: SetNull)
  thesis                       Thesis?                     @relation(fields: [thesisId], references: [id], onDelete: SetNull)
  thesisVersion                ThesisVersion?              @relation(fields: [thesisVersionId], references: [id], onDelete: SetNull)
  thesisExaminerAssignment     ThesisExaminerAssignment?   @relation(fields: [thesisExaminerAssignmentId], references: [id], onDelete: SetNull)
  correctionDocument           CorrectionDocument?         @relation(fields: [correctionDocumentId], references: [id], onDelete: SetNull)
  correctionSubmission         CorrectionSubmission?       @relation(fields: [correctionSubmissionId], references: [id], onDelete: SetNull)
  evaluationForm               EvaluationForm?             @relation(fields: [evaluationFormId], references: [id], onDelete: SetNull)
  applicationProposalVersion   ApplicationProposalVersion? @relation(fields: [applicationProposalVersionId], references: [id], onDelete: SetNull)
  progressReportVersion        ProgressReportVersion?      @relation(fields: [progressReportVersionId], references: [id], onDelete: SetNull)
  stagedUploadFile             StagedUploadFile?
  accessEvents                 DocumentAccessEvent[]
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  @@index([documentType, isDeleted])
  @@index([researchProposalId, version])
  @@index([proposalVersionId])
  @@index([ethicsApprovalId])
  @@index([thesisId, version])
  @@index([thesisVersionId])
  @@index([thesisExaminerAssignmentId])
  @@index([correctionSubmissionId])
  @@index([evaluationFormId])
  @@index([applicationProposalVersionId])
  @@index([progressReportVersionId])
  @@map("documents")
}

model UploadSession {
  id                  String              @id @default(cuid())
  ownerUserId         String?
  capabilityTokenHash String?             @unique
  purpose             UploadPurpose
  status              UploadSessionStatus @default(OPEN)
  idempotencyKey      String              @unique
  expiresAt           DateTime
  finalizedAt         DateTime?
  finalizedEntityId   String?
  result              Json?
  abortedAt           DateTime?
  failureReason       String?
  requestCount        Int                 @default(0)
  lastRequestAt       DateTime?
  files               StagedUploadFile[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([ownerUserId, status])
  @@index([status, expiresAt])
  @@map("upload_sessions")
}

model StagedUploadFile {
  id                String            @id @default(cuid())
  uploadSessionId   String
  ordinal           Int
  fileName          String
  expectedMimeType  String
  expectedSizeBytes Int
  expectedSha256    String?
  storagePath       String            @unique
  actualMimeType    String?
  actualSizeBytes   Int?
  actualSha256      String?
  status            UploadFileStatus  @default(PENDING)
  malwareScanStatus MalwareScanStatus @default(PENDING)
  verifiedAt        DateTime?
  rejectionReason   String?
  documentId        String?           @unique
  uploadSession     UploadSession     @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)
  document          Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([uploadSessionId, ordinal])
  @@index([uploadSessionId, status])
  @@map("staged_upload_files")
}

model DocumentAccessEvent {
  id                 String                 @id @default(cuid())
  actorUserId        String
  actorRole          UserRole
  documentId         String
  action             DocumentAccessAction
  decision           DocumentAccessDecision
  reasonCode         String
  storagePathHash    String
  signedUrlExpiresAt DateTime?
  occurredAt         DateTime               @default(now())
  document           Document               @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([documentId, occurredAt])
  @@map("document_access_events")
}

model DocumentMigrationIssue {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  reason     String
  details    Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([resolvedAt, createdAt])
  @@map("document_migration_issues")
}

model PublicRequestRateLimit {
  keyHash      String   @id
  windowStart  DateTime
  requestCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([windowStart])
  @@map("public_request_rate_limits")
}

model Notification {
  id              String            @id @default(cuid())
  recipientId     String
  studentId       String?
  event           NotificationEvent
  title           String
  message         String
  actionUrl       String?
  outboxMessageId String?           @unique
  isRead          Boolean           @default(false)
  recipient       User              @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  student         Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  outboxMessage   OutboxMessage?    @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([recipientId, isRead])
  @@map("notifications")
}

model LifecycleAuditEvent {
  id            String   @id @default(cuid())
  eventKey      String   @unique
  eventType     String
  aggregateType String
  aggregateId   String
  actorUserId   String?
  actorRole     String?
  actorLabel    String?
  previousState String?
  newState      String?
  metadata      Json?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  actor         User?    @relation("LifecycleAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("lifecycle_audit_events")
}

model OutboxMessage {
  id                String                  @id @default(cuid())
  eventKey          String                  @unique
  topic             String
  recipientId       String?
  studentId         String?
  notificationEvent NotificationEvent?
  title             String?
  message           String?
  actionUrl         String?
  payload           Json
  status            OutboxStatus            @default(PENDING)
  attempts          Int                     @default(0)
  maxAttempts       Int                     @default(5)
  availableAt       DateTime                @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  lastError         String?
  deliveredAt       DateTime?
  recipient         User?                   @relation("OutboxRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  student           Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)
  notification      Notification?
  deliveryAttempts  OutboxDeliveryAttempt[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([recipientId, createdAt])
  @@index([topic, createdAt])
  @@map("outbox_messages")
}

model OutboxDeliveryAttempt {
  id           String        @id @default(cuid())
  outboxId     String
  attempt      Int
  succeeded    Boolean
  errorMessage String?
  startedAt    DateTime      @default(now())
  completedAt  DateTime      @default(now())
  outbox       OutboxMessage @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@unique([outboxId, attempt])
  @@index([succeeded, completedAt])
  @@map("outbox_delivery_attempts")
}

model NotificationLog {
  id             String                     @id @default(cuid())
  recipientId    String
  event          NotificationEvent
  subject        String
  deliveryStatus NotificationDeliveryStatus
  failureReason  String?
  metadata       Json?
  recipient      User                       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([recipientId, deliveryStatus])
  @@index([event, createdAt])
  @@map("notification_logs")
}

model MaintenanceRun {
  id           String               @id @default(cuid())
  jobName      String
  runKey       String
  status       MaintenanceRunStatus @default(RUNNING)
  result       Json?
  errorMessage String?
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  failedAt     DateTime?
  updatedAt    DateTime             @updatedAt

  @@unique([jobName, runKey])
  @@index([status, startedAt])
  @@map("maintenance_runs")
}
