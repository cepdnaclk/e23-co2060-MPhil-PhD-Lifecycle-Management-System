{
  "name": "e23-co2060-mphil-phd-lifecycle-management-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:check": "node scripts/check-migration-policy.mjs",
    "database:reset": "node scripts/reset-sample-database.mjs",
    "db:reset:sample": "node scripts/reset-sample-database.mjs",
    "database:seed": "prisma db seed",
    "database:reconcile-migration-ledger": "node scripts/reconcile-obsolete-baseline-migration.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:database": "vitest run tests/integration/student-user-link.test.ts",
    "test:e2e": "playwright test --grep-invert @external",
    "test:e2e:external": "node scripts/run-external-e2e.mjs",
    "test:e2e:lifecycle": "node scripts/run-lifecycle-e2e.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@sentry/nextjs": "10.66.0",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "12.16.0",
    "firebase-admin": "14.2.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "nodemailer": "9.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "2.3.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "prisma": "7.9.1",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "postcss": "8.5.25",
    "firebase-admin": {
      "@google-cloud/firestore": {
        "google-gax": {
          "rimraf": "6.1.3"
        }
      }
    },
    "next": {
      "sharp": "0.35.3"
    }
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
